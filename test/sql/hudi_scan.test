# name: test/sql/hudi_scan.test
# description: test duckdb_hudi extension (hudi_scan table function)
# group: [duckdb_hudi]

# ---------------------------------------------------------------------------
# Pre-load: the function must not exist yet
# ---------------------------------------------------------------------------
statement error
SELECT * FROM hudi_scan('/tmp/nonexistent');
----
Catalog Error: Table Function with name hudi_scan does not exist!

# ---------------------------------------------------------------------------
# Load the extension
# ---------------------------------------------------------------------------
require duckdb_hudi

# ---------------------------------------------------------------------------
# Post-load: calling hudi_scan with a path that does not exist on disk should
# raise an I/O / table-not-found error rather than a catalog error, which
# confirms the function is registered and reachable.
# ---------------------------------------------------------------------------
statement error
SELECT * FROM hudi_scan('/tmp/no_such_hudi_table');
----

# ---------------------------------------------------------------------------
# Live smoke tests against the bundled fixture (5 rows across 3 city partitions:
# san_francisco=3, sao_paulo=1, chennai=1). Paths are relative to the repo root,
# which is where `make test_debug` / `make test_release` run from.
# ---------------------------------------------------------------------------
query I
SELECT count(*) FROM hudi_scan('fixtures/hudi_table');
----
5

query TI
SELECT city, count(*) FROM hudi_scan('fixtures/hudi_table') GROUP BY city ORDER BY city;
----
chennai	1
san_francisco	3
sao_paulo	1
